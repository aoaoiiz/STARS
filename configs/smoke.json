{
  "seed": 42,
  "data": {
    "name": "smoke",
    "annotation_path": "sample_data/smoke_annotations.jsonl",
    "video_root": "",
    "limit": 3
  },
  "sampling": {
    "num_bins": 6,
    "frames_per_bin": 2,
    "max_frames": 12,
    "synthetic_size": 96
  },
  "generation": {
    "num_candidates": 5,
    "target_duration_sec": 30,
    "segments": 5,
    "cta_position": "late",
    "pace": "medium",
    "information_density": "medium",
    "selling_points": ["核心卖点", "使用场景", "信任背书"],
    "risk_terms": ["绝对", "第一", "治愈", "稳赚"]
  },
  "reward": {
    "alignment_weight": 0.35,
    "readability_weight": 0.2,
    "rhythm_weight": 0.2,
    "control_weight": 0.2,
    "risk_weight": 0.05,
    "text_reasoning_weight": 0.0,
    "preference_margin": 0.08
  },
  "models": {
    "mode": "local_smoke",
    "active_video_model": "local_stats",
    "active_text_reward_model": "",
    "allow_heavy_model_load": false,
    "endpoints": [
      {
        "id": "local_stats",
        "name": "StatsFrameEncoder",
        "role": "video_representation",
        "provider": "local",
        "adapter": "stats_frame_encoder",
        "enabled": true,
        "notes": "本地 smoke test 使用的轻量确定性帧统计 encoder，不是正式大模型。"
      }
    ]
  },
  "output_dir": "outputs/smoke"
}
